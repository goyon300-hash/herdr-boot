[Unit]
Description=Populate trusted Herdr startup panes after graphical login
PartOf=graphical-session.target

[Service]
Type=oneshot
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/herdr-boot apply
RemainAfterExit=yes
Restart=on-failure
RestartSec=30
TimeoutStartSec=5min
UMask=0077

[Install]
WantedBy=graphical-session.target
